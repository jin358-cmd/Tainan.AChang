# This implementation uses Supabase RLS and an explicitly public publishable key.
# No database service-role credential belongs in Vercel or GitHub.
# Supabase Edge Function achang-admin-provision obtains its service-role key from
# the Supabase managed function runtime and verifies each caller's admin identity.
# Configure authorized Auth users and member_accounts via Supabase dashboard.
SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=SET_IN_VERCEL_PREVIEW_ONLY
EXPECTED_SUPABASE_PROJECT_REF=YOUR_TEST_PROJECT_REF
